# ---- 前端（Vite 会打包进去，可以公开）----
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ---- 只在服务器（/api/*）----
ANTHROPIC_API_KEY=sk-ant-...
# 只放这个邮箱用 AI（强烈建议设）
OWNER_EMAIL=you@example.com
# 每月 AI 预算（令吉）和汇率，超过预算 /api 会回 402
AI_MONTHLY_BUDGET_MYR=50
USD_TO_MYR=4.4

# 第 3 阶段：TickTick 时间盒（选填；TickTick 网页版 → 设定 → 帐户 → API Token）
TICKTICK_TOKEN=
# 放进哪个清单（选填，没设就进收集箱）
TICKTICK_PROJECT_ID=

# 第 4 阶段：公开名片页 /c + 扫码留资料（/api/card、/api/inbox）
# Supabase → Project Settings → API → service_role（Secret）。Vercel 勾 Sensitive；绝对不要加 VITE_ 前缀
SUPABASE_SERVICE_ROLE_KEY=
# 选填：直接给主人的 user id（Supabase → Authentication → Users），不设就用 OWNER_EMAIL 去找
OWNER_USER_ID=
# 选填：Cloudflare Turnstile 防机器人（两个都设才会启用）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
