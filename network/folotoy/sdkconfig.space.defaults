# SPACE card：在上游 sdkconfig.defaults 后面接上这几行（build.sh 自动接）
# LVGL 内建的二维码元件（lv_qrcode，用 qrcodegen、ECC M）
CONFIG_LV_USE_QRCODE=y
# 车用遥控器画面的大图示（蓝牙、播放、下一首）
CONFIG_LV_FONT_MONTSERRAT_48=y

# 车用遥控器：BLE HID（NimBLE + ESP-IDF esp_hid）。名片模式不会启动蓝牙。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# 配对资料存 NVS：下次开机手机自动重连（上游预设是关的）
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
# HID / 装置资讯 / 电量服务（esp_hid 的 NimBLE 版用到）
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_DIS_SERVICE=y
CONFIG_BT_NIMBLE_SVC_DIS_MANUFACTURER_NAME=y
CONFIG_BT_NIMBLE_SVC_DIS_SERIAL_NUMBER=y
CONFIG_BT_NIMBLE_SVC_DIS_PNP_ID=y
CONFIG_BT_NIMBLE_BAS_SERVICE=y
