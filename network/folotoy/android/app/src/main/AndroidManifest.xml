<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 连 FoloToy（Android 12 起叫「附近的装置」） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- 常联络：从通讯录选朋友、找他的 WhatsApp 通话 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 找 FoloToy：断线时记下手机位置（「最后在哪里」；断线多半在背景，要「一律允许」） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- DEKU：按住 FoloToy 确定时，用手机的语音转文字听你说什么 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 忘了带提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 请手机不要为了省电把无障碍服务关掉 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11 起要宣告会打开哪些 app -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.tencent.weread" />
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
        <!-- Android 11 起要宣告：用手机的语音转文字服务（DEKU） -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_media_play"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CarService"
            android:exported="false"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/car_service" />
        </service>
    </application>
</manifest>
