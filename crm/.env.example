# Sail CRM — copy to .env.local for local dev, set in hosting platform for prod.
#
# Cloud sync (recommended for any multi-user / multi-device setup).
# When both are set, the app uses Supabase for storage, auth & realtime.
# When unset, the app falls back to IndexedDB (this browser only).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Supabase Edge Function URL for AI weekly insights.
# Direct browser → api.anthropic.com calls leak the API key and are blocked
# by CORS, so we route them through an Edge Function. Leave blank to hide
# the AI insights button.
VITE_AI_INSIGHTS_URL=
